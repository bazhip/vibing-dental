# Don't ship source maps with production builds — they reconstruct the
# original TypeScript (comments included) from the deployed site.
GENERATE_SOURCEMAP=false

# Keep the webpack runtime as a file instead of an inline <script> — the
# CSP (vercel.json) is script-src 'self', which blocks inline scripts.
INLINE_RUNTIME_CHUNK=false

# Supabase project (public values — RLS protects the data; both ship in
# the bundle by design). Remove both to run standalone (legacy password,
# localStorage only).
REACT_APP_SUPABASE_URL=https://ocjnngfzwyajhgqzicsf.supabase.co
REACT_APP_SUPABASE_ANON_KEY=sb_publishable_bVaeTVy9c2I05Xn6eYiUFg_FEDuogA_
