    { "id": "mobility", "en": "tooth mobility", "fr": "mobilité dentaire", "de": "Zahnbeweglichkeit", "it": "mobilità dentale", "es": "movilidad dental", "note": "UI column label: 'Mobility' (fr 'Mobilité', de 'Beweglichkeit', it 'Mobilità', es 'Movilidad'), graded M0–M3. Owner report (lay): 'loose tooth' / 'dent mobile' / 'lockerer Zahn' / 'dente che si muove' / 'diente flojo'." },
    { "id": "recession", "en": "gingival recession", "fr": "récession gingivale", "de": "Gingivarezession", "it": "recessione gengivale", "es": "recesión gingival", "note": "UI column label: 'Recession'; AVDC GR. Owner report (lay): 'receding gums' / 'rétraction des gencives' / 'Zahnfleischrückgang' / 'gengive che si ritirano' / 'retracción de las encías'." },
    { "id": "pocket", "en": "periodontal pocket", "fr": "poche parodontale", "de": "Parodontaltasche", "it": "tasca parodontale", "es": "bolsa periodontal", "note": "UI column label: 'Pocket' (probing depth in mm). Owner report (lay): 'deepened gum pocket' / 'poche gingivale approfondie' / 'vertiefte Zahnfleischtasche' / 'tasca gengivale profonda' / 'bolsa periodontal profunda'. Clinically 'gingival pocket' is a pseudopocket without attachment loss, so use 'poche gingivale' only in lay text." },
    { "id": "probing_depth", "en": "probing depth", "fr": "profondeur de sondage", "de": "Sondierungstiefe", "it": "profondità di sondaggio", "es": "profundidad de sondaje" },
    { "id": "attachment_loss", "en": "attachment loss", "fr": "perte d’attache", "de": "Attachmentverlust", "it": "perdita di attacco", "es": "pérdida de inserción" },
    { "id": "furcation", "en": "furcation involvement", "fr": "atteinte de furcation", "de": "Furkationsbefall", "it": "coinvolgimento della forcazione", "es": "lesión de furca", "note": "UI column label: 'Furcation' (fr 'Furcation', de 'Furkation', it 'Forcazione', es 'Furca'), graded F1–F3. AVDC also says 'furcation exposure'. Owner report (lay): 'bone loss between the roots' / 'perte osseuse entre les racines' / 'Knochenabbau zwischen den Wurzeln' / 'perdita di osso tra le radici' / 'pérdida de hueso entre las raíces'." },
    { "id": "hyperplasia", "en": "gingival enlargement", "fr": "accroissement gingival", "de": "Gingivavergrößerung", "it": "ingrossamento gengivale", "es": "agrandamiento gingival", "note": "The data field is named 'hyperplasia' but the UI column reads 'Enlargement': AVDC uses 'gingival enlargement' (GE) when there is no histological diagnosis. Keep 'gingival hyperplasia' for the histological diagnosis (see gingival_hyperplasia). Owner report (lay): 'overgrown gum tissue' / 'prolifération des gencives' / 'Zahnfleischwucherung' / 'crescita eccessiva delle gengive' / 'crecimiento excesivo de las encías'." },
    { "id": "gingival_hyperplasia", "en": "gingival hyperplasia", "fr": "hyperplasie gingivale", "de": "Gingivahyperplasie", "it": "iperplasia gengivale", "es": "hiperplasia gingival", "note": "AVDC GH: histologically confirmed. Do not use it for the 'Enlargement' column (see hyperplasia)." },
    { "id": "plaque", "en": "dental plaque", "fr": "plaque dentaire", "de": "Plaque", "it": "placca batterica", "es": "placa bacteriana" },
    { "id": "calculus", "en": "calculus", "fr": "calcul dentaire", "de": "Zahnstein", "it": "tartaro", "es": "cálculo dental", "note": "UI column label: 'Calculus', graded. Lay word: 'tartar' / 'tartre' / 'Zahnstein' / 'tartaro' / 'sarro'. The owner report says 'tartar buildup' / 'accumulation de tartre' / 'Zahnsteinbildung' / 'accumulo di tartaro' / 'acumulación de sarro'. 'Zahnstein' and 'tartaro' are standard in both clinical and lay text (Italian clinical alternative: 'calcolo dentale')." },
    { "id": "gingivitis", "en": "gingivitis", "fr": "gingivite", "de": "Gingivitis", "it": "gengivite", "es": "gingivitis", "note": "UI column label: 'Gingivitis', graded. Owner report (lay): 'gum inflammation' / 'inflammation des gencives' / 'Zahnfleischentzündung' / 'infiammazione delle gengive' / 'inflamación de las encías'." },
