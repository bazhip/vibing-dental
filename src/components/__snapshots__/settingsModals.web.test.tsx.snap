on><option value="N/POL" label="Nasopharyngeal polyp"></option><option value="OM" label="Oral/maxillofacial mass"></option><option value="OM/AA" label="Oral mass, acanthomatous ameloblastoma"></option><option value="OM/AD" label="Oral mass, adenoma"></option><option value="OM/ADC" label="Oral mass, adenocarcinoma"></option><option value="OM/APN" label="Oral mass, anaplastic neoplasm"></option><option value="OM/APO" label="Oral mass, amyloid-producing odontogenic tumor"></option><option value="OM/CE" label="Oral mass, cementoma"></option><option value="OM/FIO" label="Oral mass, feline inductive odontogenic tumor"></option><option value="OM/FS" label="Oral mass, fibrosarcoma"></option><option value="OM/GCG" label="Oral mass, giant cell granuloma"></option><option value="OM/GCT" label="Oral mass, granular cell tumor"></option><option value="OM/HS" label="Oral mass, hemangiosarcoma"></option><option value="OM/LI" label="Oral mass, lipoma"></option><option value="OM/LS" label="Oral mass, lymphosarcoma"></option><option value="OM/MCT" label="Oral mass, mast cell tumor"></option><option value="OM/MM" label="Oral mass, malignant melanoma"></option><option value="OM/MTB" label="Oral mass, multilobular tumor of bone"></option><option value="OM/OO" label="Oral mass, osteoma"></option><option value="OM/OS" label="Oral mass, osteosarcoma"></option><option value="OM/PAP" label="Oral mass, papilloma"></option><option value="OM/PCT" label="Oral mass, plasma cell tumor"></option><option value="OM/PNT" label="Oral mass, peripheral nerve sheath tumor"></option><option value="OM/POF" label="Oral mass, peripheral odontogenic fibroma"></option><option value="OM/RBM" label="Oral mass, rhabdomyosarcoma"></option><option value="OM/SCC" label="Oral mass, squamous cell carcinoma"></option><option value="OM/UDN" label="Oral mass, undifferentiated neoplasm"></option><option value="N/SCC" label="Nasal squamous cell carcinoma"></option><option value="SG/ADC" label="Salivary gland adenocarcinoma">