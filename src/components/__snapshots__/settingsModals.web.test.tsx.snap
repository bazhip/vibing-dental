exports[`settings dialogs on the website render as before > Account 1`] = `"<div><div class="ai-settings-overlay" role="dialog" aria-modal="true" aria-labelledby="account-settings-title"><div class="ai-settings-modal" tabindex="-1"><header class="ai-settings-header"><h2 id="account-settings-title">Account settings</h2><button type="button" class="pdf-preview-close" aria-label="Close">×</button></header><div class="ai-settings-body"><form class="ai-settings-section"><h3 class="ai-settings-subhead">Doctor name</h3><p class="ai-settings-blurb">Printed under the logo on every chart you create.</p><label class="patient-form__label">Doctor name<input class="patient-form__input" placeholder="e.g. Dr. Jane Smith, DVM, DAVDC" type="text" value="Dr Me"></label><div class="practice-logo-actions" style="margin-top: 0.6rem;"><button type="submit" class="diagram-view__action" disabled="">Save doctor name</button></div></form><section class="ai-settings-section"><h3 class="ai-settings-subhead" id="account-language-heading">Language</h3><select class="patient-form__input" aria-labelledby="account-language-heading"><option value="en">English</option><option value="fr">Français</option><option value="de">Deutsch</option><option value="it">Italiano</option><option value="es">Español</option></select></section><form class="ai-settings-section" novalidate=""><h3 class="ai-settings-subhead">Email</h3><label class="patient-form__label">Sign-in email<input class="patient-form__input" autocomplete="email" type="email" value="me@vet.com"></label><div class="practice-logo-actions" style="margin-top: 0.6rem;"><button type="submit" class="diagram-view__action" disabled="">Change email</button></div></form><form class="ai-settings-section" novalidate=""><h3 class="ai-settings-subhead">Password</h3><input autocomplete="username" readonly="" hidden="" type="text" value="me@vet.com" name="username"><label class="patient-form__label">New password<span class="settings-password"><input class="patient-form__input" autocomplete="new-password" placeholder="At least 8 characters" type="password" value=""><button type="button" class="settings-password__toggle" aria-label="Show passwords" aria-pressed="false">Show</button></span></label><label class="patient-form__label" style="margin-top: 0.6rem;">Confirm new password<input class="patient-form__input" autocomplete="new-password" type="password" value=""></label><div class="practice-logo-actions" style="margin-top: 0.6rem;"><button type="submit" class="diagram-view__action" disabled="">Update password</button></div></form><section class="ai-settings-section"><h3 class="ai-settings-subhead">Delete account</h3><p class="patient-form__hint">Permanently deletes your account, your private charts and their images. Charts you shared with a practice stay with the practice.</p><div class="practice-logo-actions"><button type="button" class="diagram-view__action diagram-view__action--danger">Delete account…</button></div></section></div><footer class="ai-settings-footer"><button type="button" class="entry-grid__button entry-grid__button--topbar">Done</button></footer></div></div></div>"`;

exports[`settings dialogs on the website render as before > Admin chart viewer 1`] = `"<div></div><div class="ai-settings-overlay admin-chart-viewer__overlay" role="dialog" aria-modal="true" aria-label="Admin chart view"><div class="ai-settings-modal admin-chart-viewer" tabindex="-1"><header class="ai-settings-header"><h2>SoCal Vet · Unnamed patient</h2><button type="button" class="pdf-preview-close" aria-label="Close">×</button></header><div class="admin-chart-viewer__notice">Read-only admin view. This view is logged.</div><div class="admin-chart-viewer__body"><p class="login-error" role="alert">This chart's data is damaged and can't be shown.</p></div></div></div>"`;

exports[`settings dialogs on the website render as before > Admin panel 1`] = `"<div><div class="ai-settings-overlay" role="dialog" aria-modal="true" aria-label="Admin panel"><div class="ai-settings-modal chart-library-modal admin-panel" tabindex="-1"><header class="ai-settings-header"><h2>Admin panel</h2><button type="button" class="pdf-preview-close" aria-label="Close">×</button></header><div class="chart-library-modal__body"><p class="chart-library__sub">Loading…</p><div class="admin-panel__tabs" role="tablist"><button type="button" role="tab" aria-selected="true" class="admin-panel__tab admin-panel__tab--on">Accounts</button><button type="button" role="tab" aria-selected="false" class="admin-panel__tab">Practices</button><button type="button" role="tab" aria-selected="false" class="admin-panel__tab">Billing</button><button type="button" role="tab" aria-selected="false" class="admin-panel__tab">AI</button></div><div class="admin-panel__banner"><div class="login-error" role="alert"><span>offline</span><button type="button" class="admin-panel__banner-dismiss" aria-label="Dismiss error">×</button></div></div><div class="admin-panel__search"><input class="patient-form__input" aria-label="Search users" placeholder="Search users by email or name" type="search" value=""></div><div class="chart-library__empty">Couldn’t load users. <button type="button" class="diagram-view__action">Retry</button></div></div></div></div></div>"`;

exports[`settings dialogs on the website render as before > Chart settings 1`] = `"<div></div><div class="ai-settings-overlay" role="dialog" aria-modal="true" aria-label="Chart settings"><div class="ai-settings-modal chart-settings" tabindex="-1"><header class="ai-settings-header"><h2>Chart settings</h2><button type="button" class="pdf-preview-close" aria-label="Close">×</button></header><div class="ai-settings-body chart-settings__body"><p class="chart-settings__note">Just for you — these follow your account on every device. Changes save right away.</p><section class="chart-settings__group"><h3 class="ai-settings-subhead">Charting</h3><fieldset class="chart-settings__field"><legend>View</legend><label class="chart-settings__choice"><input type="radio" checked="" name="chartingView">Grid</label><label class="chart-settings__choice"><input type="radio" name="chartingView">By tooth</label></fieldset><fieldset class="chart-settings__field"><legend>Pocket depths</legend><label class="chart-settings__choice"><input type="radio" checked="" name="pocketMode">One per tooth</label><label class="chart-settings__choice"><input type="radio" name="pocketMode">One per root <span class="chart-settings__hint">M / D, or MB / MP / D on three-rooted teeth</span></label></fieldset><fieldset class="chart-settings__field"><legend>Space key in the grid</legend><label class="chart-settings__choice"><input type="radio" checked="" name="spaceKey">Moves down to the next tooth <span class="chart-settings__hint">fast for calling out a run of depths</span></label><label class="chart-settings__choice"><input type="radio" name="spaceKey">Types a space</label></fieldset><fieldset class="chart-settings__field"><legend>After tapping a score in the grid</legend><label class="chart-settings__choice"><input type="radio" checked="" name="scoreTapMoves">Go to the next finding on the same tooth <span class="chart-settings__hint">mobility → recession → … for tooth-by-tooth exams</span></label><label class="chart-settings__choice"><input type="radio" name="scoreTapMoves">Go down to the next tooth <span class="chart-settings__hint">for scoring one finding across the mouth</span></label><label class="chart-settings__choice"><input type="radio" name="scoreTapMoves">Stay put</label></fieldset><fieldset class="chart-settings__field"><legend>Columns</legend><div class="chart-settings__grid"><label class="chart-settings__choice"><input type="checkbox" checked="">Mobility</label><label class="chart-settings__choice"><input type="checkbox" checked="">Recession</label><label class="chart-settings__choice"><input type="checkbox" checked="">Pocket</label><label class="chart-settings__choice"><input type="checkbox" checked="">Furcation</label><label class="chart-settings__choice"><input type="checkbox" checked="">Enlargement</label><label class="chart-settings__choice"><input type="checkbox" checked="">Calculus</label><label class="chart-settings__choice"><input type="checkbox" checked="">Gingivitis</label><label class="chart-settings__choice"><input type="checkbox" checked="">PD Stage</label></div></fieldset></section><section class="chart-settings__group"><h3 class="ai-settings-subhead">Beside the teeth</h3><label class="chart-settings__choice"><input type="checkbox">Show findings on the Diagnosis diagram <span class="chart-settings__hint">(and in the PDF)</span></label><fieldset class="chart-settings__field" disabled=""><legend>Include</legend><div class="chart-settings__grid"><label class="chart-settings__choice"><input type="checkbox" checked="">Mobility</label><label class="chart-settings__choice"><input type="checkbox" checked="">Recession</label><label class="chart-settings__choice"><input type="checkbox" checked="">Pocket</label><label class="chart-settings__choice"><input type="checkbox" checked="">Furcation</label><label class="chart-settings__choice"><input type="checkbox" checked="">Enlargement</label><label class="chart-settings__choice"><input type="checkbox" checked="">Calculus</label><label class="chart-settings__choice"><input type="checkbox" checked="">Gingivitis</label><label class="chart-settings__choice"><input type="checkbox" checked="">PD Stage</label></div></fieldset></section><section class="chart-settings__group"><fieldset class="chart-settings__field quick-codes-editor"><legend>Quick codes</legend><p class="chart-settings__note">One-tap buttons for codes you chart often, such as T/SN (supernumerary tooth). They appear under the diagnosis note in By tooth and above the Diagnosis diagram.</p><div class="quick-codes-editor__row"><span class="quick-codes-editor__code">T/SN</span><span class="quick-codes-editor__def">Supernumerary tooth</span><button type="button" class="diagram-view__action custom-def__remove" aria-label="Remove T/SN">Remove</button></div><div class="quick-codes-editor__add"><input list="_r_0_" class="patient-form__input" placeholder="Code, e.g. T/SR" aria-label="Code to add" autocapitalize="characters" autocomplete="off" maxlength="16" type="text" value=""><button type="button" class="anesthesia-drug__add" disabled=""><span aria-hidden="true">+</span> Add</button><datalist id="_r_0_"><option value="MAL" label="Malocclusion"></option><option value="MAL1" label="Class 1 malocclusion (neutroclusion; dental malocclusion with normal jaw length relationship)"></option><option value="MAL2" label="Class 2 malocclusion (mandibular distoclusion; lower jaw relatively shorter than the upper)"></option><option value="MAL3" label="Class 3 malocclusion (mandibular mesioclusion; upper jaw relatively shorter than the lower)"></option><option value="MAL4" label="Class 4 malocclusion (asymmetrical skeletal malocclusion)"></option><option value="MAL4/DV" label="Asymmetrical skeletal malocclusion, dorsoventral"></option><option value="MAL4/RC" label="Asymmetrical skeletal malocclusion, rostrocaudal"></option><option value="MAL4/STS" label="Asymmetrical skeletal malocclusion, side-to-side"></option><option value="MAL1/BV" label="Buccoversion"></option><option value="MAL1/DV" label="Distoversion"></option><option value="MAL1/LABV" label="Labioversion"></option><option value="MAL1/LV" label="Linguoversion"></option><option value="MAL1/MV" label="Mesioversion"></option><option value="MAL1/PV" label="Palatoversion"></option><option value="CB" label="Crossbite"></option><option value="CB/C" label="Crossbite, caudal"></option><option value="CB/R" label="Crossbite, rostral"></option><option value="ANO" label="Anodontia"></option><option value="HYP" label="Hypodontia"></option><option value="OLI" label="Oligodontia"></option><option value="T/SN" label="Supernumerary tooth"></option><option value="T/SR" label="Supernumerary root"></option><option value="DT" label="Deciduous tooth"></option><option value="DT/P" label="Persistent deciduous tooth"></option><option value="T/A" label="Avulsed tooth"></option><option value="T/E" label="Embedded tooth"></option><option value="T/I" label="Impacted tooth"></option><option value="T/LUX" label="Luxated tooth"></option><option value="T/U" label="Unerupted tooth"></option><option value="ATE" label="Abnormal tooth extrusion"></option><option value="T/EL" label="Tooth elongation"></option><option value="RCR" label="Retained crown-root"></option><option value="RTR" label="Retained root"></option><option value="T/CCR" label="Concrescence"></option><option value="T/DEN" label="Dens invaginatus"></option><option value="T/FUS" label="Fusion"></option><option value="T/GEM" label="Gemination"></option><option value="T/MAC" label="Macrodontia"></option><option value="T/MIC" label="Microdontia"></option><option value="T/TRA" label="Transposition"></option><option value="E/P" label="Enamel pearl"></option><option value="PD" label="Periodontal disease"></option><option value="PD0" label="No periodontal disease (clinically normal)"></option><option value="PD1" label="Gingivitis only (no attachment loss)"></option><option value="PD2" label="Early periodontitis (<25% att