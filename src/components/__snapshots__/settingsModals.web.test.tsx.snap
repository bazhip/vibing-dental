trasonography"></option><option value="SCI" label="Scintigraphy"></option><option value="N/EN" label="Rhinoscopy"></option><option value="N/LAV" label="Nasal lavage"></option><option value="B" label="Biopsy"></option><option value="B/B" label="Biopsy, bite"></option><option value="B/CN" label="Biopsy, core needle"></option><option value="B/E" label="Biopsy, excisional"></option><option value="B/I" label="Biopsy, incisional"></option><option value="B/NA" label="Biopsy, needle aspiration"></option><option value="B/NB" label="Biopsy, needle"></option><option value="B/P" label="Biopsy, punch"></option><option value="B/S" label="Biopsy, surface"></option><option value="CS" label="Culture / sensitivity"></option><option value="TP" label="Treatment plan"></option><option value="PRO" label="Professional dental cleaning (scaling, polishing, irrigation)"></option><option value="GC" label="Gingival curettage"></option><option value="RP/C" label="Closed root planing"></option><option value="RP/O" label="Open root planing"></option><option value="GV" label="Gingivoplasty / gingivectomy"></option><option value="F" label="Flap"></option><option value="F/AD" label="Advancement flap"></option><option value="F/AP" label="Apically positioned flap"></option><option value="F/CO" label="Coronally positioned flap"></option><option value="F/EN" label="Envelope flap"></option><option value="F/HI" label="Hinged (overlapping) flap"></option><option value="F/IS" label="Island flap"></option><option value="F/LA" label="Laterally positioned flap"></option><option value="F/RO" label="Rotation flap"></option><option value="F/TR" label="Transposition flap"></option><option value="CR/L" label="Crown lengthening"></option><option value="GF" label="Graft"></option><option value="GF/B" label="Bone graft"></option><option value="GF/C" label="Cartilage graft"></option><option value="GF/CT" label="Connective tissue graft"></option><option value="GF/F" label="Fat graft"></option><option value="GF/G" label="Gingival graft"></option><option value="GF/M" label="Mucosal graft"></option><option value="GF/N" label="Nerve graft"></option><option value="GF/S" label="Skin graft"></option><option value="GF/V" label="Venous graft"></option><option value="GTR" label="Guided tissue regeneration"></option><option value="FRE" label="Frenuloplasty (frenulotomy, frenulectomy)"></option><option value="RCT" label="Standard root canal therapy"></option><option value="RCT/S" label="Surgical root canal therapy"></option><option value="AP/X" label="Apicoectomy"></option><option value="VPT" label="Vital pulp therapy"></option><option value="PCD" label="Direct pulp capping"></option><option value="PCI" label="Indirect pulp capping"></option><option value="APN" label="Apexification"></option><option value="HS" label="Hemisection"></option><option value="TS" label="Trisection"></option><option value="T/XP" label="Partial tooth resection"></option><option value="RO/X" label="Root resection / amputation"></option><option value="CR/A" label="Crown amputation"></option><option value="CR/XP" label="Crown reduction"></option><option value="ODY" label="Odontoplasty"></option><option value="DP" label="Defect preparation (prior to filling a dental defect)"></option><option value="R" label="Restoration (filling of a dental defect)"></option><option value="R/A" label="Restoration, amalgam"></option><option value="R/C" label="Restoration, composite"></option><option value="R/CP" label="Restoration, compomer"></option><option value="R/I" label="Restoration, glass ionomer"></option><option value="PCB" label="Post-and-core build-up"></option><option value="CR/P" label="Crown preparation"></option><option value="CR/C" label="Ceramic crown (full)"></option><option value="CR/C/P" label="Ceramic crown (partial)"></option><option value="CR/M" label="Metal crown (full)"></option><option value="CR/M/P" label="Metal crown (partial)"></option><option value="CR/R" label="Resin crown (full)"></option><option value="CR/R/P" label="Resin crown (partial)"></option><option value="CR/PFM" label="Porcelain-fused-to-metal crown (full)"></option><option value="CR/PFM/P" label="Porcelain-fused-to-metal crown (partial)"></option><option value="CR/T" label="Temporary crown"></option><option value="CR/E" label="Crown extension"></option><option value="BRI" label="Bridge"></option><option value="POB" label="Palatal obturator"></option><option value="IM" label="Detailed imprint of hard and/or soft tissues"></option><option value="IM/F" label="Full-mouth impression"></option><option value="DC" label="Diagnostic cast"></option><option value="DC/D" label="Die"></option><option value="DC/SM" label="Stone model"></option><option value="BR" label="Bite registration"></option><option value="IMP" label="Implant"></option><option value="X" label="Extraction, closed (no sectioning)"></option><option value="XS" label="Extraction, closed with sectioning"></option><option value="XSS" label="Extraction, open (surgical)"></option><option value="XS/ODY" label="Removal of interproximal crown tissue to facilitate extraction"></option><option value="ALV" label="Alveolectomy / alveoloplasty"></option><option value="T/RI" label="Tooth reimplantation (avulsed tooth)"></option><option value="T/RP" label="Tooth repositioning (luxated tooth)"></option><option value="OP" label="Operculectomy"></option><option value="FB/R" label="Foreign body removal"></option><option value="LAC/R" label="Laceration repair"></option><option value="TMA/R" label="Trauma repair"></option><option value="DTC/R" label="Dentigerous cyst removal"></option><option value="MAR" label="Marsupialization"></option><option value="SG/MAR" label="Salivary gland marsupialization"></option><option value="ONF/R" label="Oronasal fistula repair"></option><option value="OAF/R" label="Oroantral fistula repair"></option><option value="IOF/R" label="Intraoral fistula repair"></option><option value="OFF/R" label="Orofacial fistula repair"></option><option value="CFP/R" label="Cleft palate repair"></option><option value="CFL/R" label="Cleft lip repair"></option><option value="CFS/R" label="Cleft soft palate repair"></option><option value="CFSH/R" label="Soft palate hypoplasia repair"></option><option value="CFSU/R" label="Unilateral cleft soft palate repair"></option><option value="CFT/R" label="Traumatic cleft palate repair"></option><option value="PDE/R" label="Acquired palate defect repair"></option><option value="ESP/R" label="Elongated soft palate reduction"></option><option value="N/NS/R" label="Naroplasty"></option><option value="N/NPS/R" label="Nasopharyngeal stenosis repair"></option><option value="LIP/A/R" label="Lip avulsion repair"></option><option value="COM" label="Commissurotomy"></option><option value="CPL" label="Cheiloplasty / commissuroplasty"></option><option value="BUC" label="Buccotomy"></option><option value="OS" label="Orthognathic surgery"></option><option value="S/P" label="Partial palatectomy"></option><option value="S/M" label="Partial mandibulectomy"></option><option value="S/MB" label="Bilateral partial mandibulectomy"></option><option value="S/MD" label="Dorsal marginal mandibulectomy"></option><option value="S/MS" label="Segmental mandibulectomy"></option><option value="S/MT" label="Total mandibulectomy"></option><option value="S/X" label="Partial maxillectomy"></option><option value="S/XB" label="Bilateral partial maxillectomy"></option><option value="LIN/X" label="Tongue resection"></option><option value="LIP/X" label="Lip/cheek resection"></option><option value="LN/X" label="Lymph node resection"></option><option value="SG/X" label="Salivary gland resection"></option><option value="TON/X" label="Tonsillectomy"></option><option value="ZYG/X" label="Zygomectomy"></option><option value="COR/X" label="Coronoidectomy"></option><option value="CON/X" label="Condylectomy"></option><option value="CTH" label="Chemotherapy"></option><option value="ITH" label="Immunotherapy"></option><option value="RTH" label="Radiotherapy"></option><option value="SYM/R" label="Symphyseal repair"></option><option value="FX/R" label="Jaw fracture repair"></option><option value="FX/R/PL" label="Jaw fracture repair, plate"></option><option value="FX/R/WIR/C" label="Cerclage wiring"></option><option value="FX/R/WIR/OS" label="Intraosseous wiring"></option><option value="FX/R/IDS" label="Interdental splinting"></option><option value="FX/R/IAS" label="Interarch splinting"></option><option value="FX/R/IQS" label="Interquadrant splinting"></option><option value="FX/R/MMF" label="Maxillomandibular fixation"></option><option value="FX/R/EXF" label="External skeletal fixation"></option><option value="FX/R/MZ" label="Muzzling"></option><option value="TMJ/FX/R" label="TMJ fracture repair"></option><option value="TMJ/LUX/R" label="TMJ luxation reduction"></option><option value="TMJ/A/R" label="TMJ ankylosis repair"></option><option value="OMJL/R" label="Open-mouth jaw locking reduction"></option><option value="IP" label="Inclined plane"></option><option value="IP/AC" label="Inclined plane, acrylic"></option><option value="IP/C" label="Inclined plane, composite"></option><option value="IP/M" label="Inclined plane, metal (lab-produced)"></option><option value="OA" label="Orthodontic appliance"></option><option value="OA/I" label="Ortho appliance, install"></option><option value="OA/A" label="Ortho appliance, adjust"></option><option value="OA/R" label="Ortho appliance, remove"></option><option value="OA/AR" label="Arch bar"></option><option value="OA/BKT" label="Bracket, button or hook"></option><option value="OA/CMB" label="Custom-made bracket"></option><option value="OA/EC" label="Ortho appliance, elastic chain/tube/thread"></option><option value="OA/WIR" label="Orthodontic wire"></option><option value="OC" label="Orthodontic counseling"></option><option value="OR" label="Orthodontic recheck"></option><option value="FT" label="Fiberotomy"></option><option value="SR" label="Surgical repositioning"></option><option value="BTH" label="Ball therapy"></option></datalist></div></fieldset></section><section class="chart-settings__group"><h3 class="ai-settings-subhead">Anesthesia</h3><fieldset class="chart-settings__field"><legend>Nerve blocks shown</legend><p class="chart-settings__note">A hidden block still shows on a chart where it has a dose.</p><div class="chart-settings__grid"><label class="chart-settings__choice"><input type="checkbox" checked="">Infraorbital</label><label class="chart-settings__choice"><input type="checkbox" checked="">Caudal maxillary</label><label class="chart-settings__choice"><input type="checkbox" checked="">Inferior alveolar</label><label class="chart-settings__choice"><input type="checkbox" checked="">Mental</label><label class="chart-settings__choice"><input type="checkbox" checked="">Other</label></div></fieldset><fieldset class="chart-settings__field"><legend>Your nerve blocks</legend><p class="chart-settings__note">Extra Right / Left rows (mL), e.g. Major palatine.</p><button type="button" class="anesthesia-drug__add"><span aria-hidden="true">+</span> Add nerve block</button></fieldset><fieldset class="chart-settings__field"><legend>Your fields</legend><p class="chart-settings__note">Shown under “Anesthesia record”, e.g. Premedication, ET tube, Fluids.</p><button type="button" class="anesthesia-drug__add"><span aria-hidden="true">+</span> Add field</button><p class="chart-settings__note">Removing a block or field here never removes what’s already charted.</p></fieldset><fieldset class="chart-settings__field"><legend>Your usual anesthetic</legend><p class="chart-settings__note">Offered as one tap on a chart with no anesthetic set.</p><div class="chart-settings__drug"><input list="chart-settings-drugs" class="patient-form__input" placeholder="e.g. Bupivacaine" aria-label="Usual anesthetic" type="text" value=""><span class="anesthesia-unit"><input inputmode="decimal" class="patient-form__input" placeholder="0.5" aria-label="Usual anesthetic strength (%)" type="text" value=""><span class="anesthesia-unit__suffix" aria-hidden="true">%</span></span><datalist id="chart-settings-drugs"><option value="Bupivacaine"></option><option value="Ropivacaine"></option><option value="Lidocaine"></option><option value="Mepivacaine"></option></datalist></div></fieldset></section><section class="chart-settings__group"><h3 class="ai-settings-subhead">Patient page</h3><label class="chart-settings__choice"><input type="checkbox">Hide the Recheck due field</label></section><section class="chart-settings__group"><h3 class="ai-settings-subhead">PDF</h3><label class="chart-settings__choice"><input disabled="" type="checkbox" checked="">Include the charting grid <span class="chart-settings__hint">(optional while findings are on the diagram)</span></label><label class="chart-settings__choice"><input type="checkbox" checked="">Include images <span class="chart-settings__hint">(4 per page, after the chart)</span></label></section></div></div></div>"`;

exports[`settings dialogs on the website render as before > Chart settings, one page 1`] = `"<div></div><div class="ai-settings-overlay" role="dialog" aria-modal="true" aria-label="Chart settings"><div class="ai-settings-modal chart-settings" tabindex="-1"><header class="ai-settings-header"><h2>Anesthesia settings</h2><button type="button" class="pdf-preview-close" aria-label="Close">×</button></header><div class="ai-settings-body chart-settings__body"><p class="chart-settings__note">Saved in this browser. Changes apply right away.</p><button type="button" class="diagram-view__action chart-settings__all">All chart settings</button><section class="chart-settings__group"><h3 class="ai-settings-subhead">Anesthesia</h3><fieldset class="chart-settings__field"><legend>Nerve blocks shown</legend><p class="chart-settings__note">A hidden block still shows on a chart where it has a dose.</p><div class="chart-settings__grid"><label class="chart-settings__choice"><input type="checkbox" checked="">Infraorbital</label><label class="chart-settings__choice"><input type="checkbox" checked="">Caudal maxillary</label><label class="chart-settings__choice"><input type="checkbox" checked="">Inferior alveolar</label><label class="chart-settings__choice"><input type="checkbox" checked="">Mental</label><label class="chart-settings__choice"><input type="checkbox" checked="">Other</label></div></fieldset><fieldset class="chart-settings__field"><legend>Your nerve blocks</legend><p class="chart-settings__note">Extra Right / Left rows (mL), e.g. Major palatine.</p><button type="button" class="anesthesia-drug__add"><span aria-hidden="true">+</span> Add nerve block</button></fieldset><fieldset class="chart-settings__field"><legend>Your fields</legend><p class="chart-settings__note">Shown under “Anesthesia record”, e.g. Premedication, ET tube, Fluids.</p><button type="button" class="anesthesia-drug__add"><span aria-hidden="true">+</span> Add field</button><p class="chart-settings__note">Removing a block or field here never removes what’s already charted.</p></fieldset><fieldset class="chart-settings__field"><legend>Your usual anesthetic</legend><p class="chart-settings__note">Offered as one tap on a chart with no anesthetic set.</p><div class="chart-settings__drug"><input list="chart-settings-drugs" class="patient-form__input" placeholder="e.g. Bupivacaine" aria-label="Usual anesthetic" type="text" value=""><span class="anesthesia-unit"><input inputmode="decimal" class="patient-form__input" placeholder="0.5" aria-label="Usual anesthetic strength (%)" type="text" value=""><span class="anesthesia-unit__suffix" aria-hidden="true">%</span></span><datalist id="chart-settings-drugs"><option value="Bupivacaine"></option><option value="Ropivacaine"></option><option value="Lidocaine"></option><option value="Mepivacaine"></option></datalist></div></fieldset></section></div></div></div>"`;

exports[`settings dialogs on the website render as before > Getting started 1`] = `"<div><div class="tour" role="dialog" aria-modal="true" aria-label="Getting started"><div class="tour__dim"></div><div class="tour__pop" style="top: 50%; left: 50%; transform: translate(-50%, -50%);" tabindex="-1"><div class="tour__eyebrow">1 of 11</div><h3 class="tour__title">Welcome to ToothOps</h3><p class="tour__body">A 60-second tour of where everything lives. You can replay it any time from Settings → Getting started.</p><div class="tour__foot"><div class="tour__dots" aria-hidden="true"><span class="tour__dot tour__dot--on"></span><span class="tour__dot"></span><span class="tour__dot"></span><span class="tour__dot"></span><span class="tour__dot"></span><span class="tour__dot"></span><span class="tour__dot"></span><span class="tour__dot"></span><span class="tour__dot"></span><span class="tour__dot"></span><span class="tour__dot"></span></div><div class="tour__nav"><button type="button" class="tour__skip">Skip</button><button type="button" class="entry-grid__button entry-grid__button--topbar">Next</button></div></div></div></div></div>"`;

exports[`settings dialogs on the website render as before > Owner report customize 1`] = `"<div><div class="ai-settings-overlay" role="dialog" aria-modal="true" aria-labelledby="report-templates-title"><div class="ai-settings-modal report-templates" tabindex="-1"><header class="ai-settings-header"><h2 id="report-templates-title">Owner report templates</h2><button type="button" class="pdf-preview-close" aria-label="Close">×</button></header><div class="report-templates__body"><nav class="report-templates__list" aria-label="Templates"><ul><li><button type="button" class="report-templates__item report-templates__item--on" aria-current="true"><span class="report-templates__item-name">Standard</span><span class="report-templates__item-meta"><span class="report-templates__badge">Default</span></span></button></li></ul><div class="report-templates__list-actions"><button type="button" class="diagram-view__action">New</button><button type="button" class="diagram-view__action">Duplicate</button><button type="button" class="diagram-view__action" disabled="" aria-label="Set as default"><span class="report-templates__long">Set as default</span><span class="report-templates__short">Set default</span></button><button type="button" class="diagram-view__action diagram-view__action--danger" disabled="">Delete</button></div></nav><div class="report-templates__editor"><fieldset class="report-templates__fieldset"><section class="ai-settings-section"><h3 class="ai-settings-subhead">Basics</h3><div class="report-templates__row"><label class="patient-form__label">Template name<input class="patient-form__input" maxlength="80" type="text" value="Standard"></label><label class="patient-form__label">Report title<input class="patient-form__input" maxlength="80" placeholder="No title" type="text" value="Dental Visit Report"></label></div><div class="report-templates__row"><label class="patient-form__label">Report language<select class="patient-form__input"><option value="en">English</option><option value="es">Español (Spanish)</option><option value="fr">Français (French)</option><option value="de">Deutsch (German)</option><option value="it">Italiano (Italian)</option><option value="pt">Português (Portuguese)</option></select></label><label class="patient-form__label">Dates<select class="patient-form__input"><option value="iso">As charted (2026-07-19)</option><option value="long">Written out, in the report language</option></select></label></div><p class="patient-form__hint">The language applies to everything the report writes for you — headings, findings, tooth names and default text. Text your team types prints as written.</p><label class="report-templates__check"><input type="checkbox" checked=""><span>Show tooth numbers <span class="patient-form__hint">— “Upper right canine tooth (104)” instead of “Upper right canine tooth”</span></span></label><label class="report-templates__check"><input type="checkbox" checked=""><span>Show grades and measurements <span class="patient-form__hint">— “tartar buildup (grade 2)” instead of “tartar buildup”</span></span></label></section><section class="ai-settings-section"><h3 class="ai-settings-subhead">Opening summary</h3><div class="report-templates__chips" role="group" aria-label="Insert a placeholder"><button type="button" class="report-templates__chip" title="Insert pet name">{pet}</button><button type="button" class="report-templates__chip" title="Insert owner name">{owner}</button><button type="button" class="report-templates__chip" title="Insert cat, dog…">{species}</button><button type="button" class="report-templates__chip" title="Insert visit date">{date}</button><button type="button" class="report-templates__chip" title="Insert practice name">{practice}</button><button type="button" class="report-templates__chip" title="Insert doctor">{doctor}</button></div><p class="patient-form__hint">Click a placeholder to insert it into the field you’re editing (any text field below). Capitalize it — {Pet} — to capitalize the value.</p><textarea class="patient-form__input report-templates__textarea" rows="4" aria-label="Opening summary template" placeholder="{pet} had a professional dental assessment and cleaning under anesthesia. This report explains what we found in everyday language — the full clinical chart with measurements is on file and available any time."></textarea><span class="patient-form__hint">Leave empty to use the standard opening shown in grey.</span></section><section class="ai-settings-section"><h3 class="ai-settings-subhead">Sections</h3><p class="patient-form__hint">Turn sections on or off, rename their headings, and set the print order. Sections with nothing to say for a visit (no extractions, no photos…) are skipped automatically.</p><ol class="report-templates__sections"><li class="report-templates__section"><div class="report-templates__section-head"><label class="report-templates__check report-templates__check--inline"><input type="checkbox" checked=""><span class="report-templates__section-name">Teeth removed</span></label><span class="report-templates__section-actions"><button type="button" class="diagram-view__action report-templates__icon" disabled="" aria-label="Move up" title="Move up">↑</button><button type="button" class="diagram-view__action report-templates__icon" aria-label="Move down" title="Move down">↓</button></span></div><input class="patient-form__input" aria-label="Teeth removed heading" maxlength="120" placeholder="Teeth removed during this visit" type="text" value=""></li><li class="report-templates__section"><div class="report-templates__section-head"><label class="report-templates__check report-templates__check--inline"><input type="checkbox" checked=""><span class="report-templates__section-name">Mouth diagram</span></label><span class="report-templates__section-actions"><button type="button" class="diagram-view__action report-templates__icon" aria-label="Move up" title="Move up">↑</button><button type="button" class="diagram-view__action report-templates__icon" aria-label="Move down" title="Move down">↓</button></span></div><input class="patient-form__input" aria-label="Mouth diagram heading" maxlength="120" placeholder="{Pet}’s mouth" type="text" value=""></li><li class="report-templates__section"><div class="report-templates__section-head"><label class="report-templates__check report-templates__check--inline"><input type="checkbox" checked=""><span class="report-templates__section-name">What we found</span></label><span class="report-templates__section-actions"><button type="button" class="diagram-view__action report-templates__icon" aria-label="Move up" title="Move up">↑</button><button type="button" class="diagram-view__action report-templates__icon" aria-label="Move down" title="Move down">↓</button></span></div><input class="patient-form__input" aria-label="What we found heading" maxlength="120" placeholder="What we found" type="text" value=""></li><li class="report-templates__section"><div class="report-templates__section-head"><label class="report-templates__check report-templates__check--inline"><input type="checkbox" checked=""><span class="report-templates__section-name">Already missing</span></label><span class="report-templates__section-actions"><button type="button" class="diagram-view__action report-templates__icon" aria-label="Move up" title="Move up">↑</button><button type="button" class="diagram-view__action report-templates__icon" aria-label="Move down" title="Move down">↓</button></span></div><input class="patient-form__input" aria-label="Already missing heading" maxlength="120" placeholder="Already missing before this visit" type="text" value=""></li><li class="report-templates__section"><div class="report-templates__section-head"><label class="report-templates__check report-templates__check--inline"><input type="checkbox" checked=""><span class="report-templates__section-name">Other exam notes</span></label><span class="report-templates__section-actions"><button type="button" class="diagram-view__action report-templates__icon" aria-label="Move up" title="Move up">↑</button><button type="button" class="diagram-view__action report-templates__icon" aria-label="Move down" title="Move down">↓</button></span></div><input class="patient-form__input" aria-label="Other exam notes heading" maxlength="120" placeholder="Other exam notes" type="text" value=""></li><li class="report-templates__section"><div class="report-templates__section-head"><label class="report-templates__check report-templates__check--inline"><input type="checkbox" checked=""><span class="report-templates__section-name">Before &amp; after photos</span></label><span class="report-templates__section-actions"><button type="button" class="diagram-view__action report-templates__icon" aria-label="Move up" title="Move up">↑</button><button type="button" class="diagram-view__action report-templates__icon" aria-label="Move down" title="Move down">↓</button></span></div><input class="patient-form__input" aria-label="Before &amp; after photos heading" maxlength="120" placeholder="Before &amp; after" type="text" value=""></li><li class="report-templates__section"><div class="report-templates__section-head"><label class="report-templates__check report-templates__check--inline"><input type="checkbox" checked=""><span class="report-templates__section-name">Note from the team</span></label><span class="report-templates__section-actions"><button type="button" class="diagram-view__action report-templates__icon" aria-label="Move up" title="Move up">↑</button><button type="button" class="diagram-view__action report-templates__icon" aria-label="Move down" title="Move down">↓</button></span></div><input class="patient-form__input" aria-label="Note from the team heading" maxlength="120" placeholder="A note from your veterinary team" type="text" value=""></li><li class="report-templates__section"><div class="report-templates__section-head"><label class="report-templates__check report-templates__check--inline"><input type="checkbox" checked=""><span class="report-templates__section-name">Home care tips</span></label><span class="report-templates__section-actions"><button type="button" class="diagram-view__action report-templates__icon" aria-label="Move up" title="Move up">↑</button><button type="button" class="diagram-view__action report-templates__icon" aria-label="Move down" title="Move down">↓</button></span></div><input class="patient-form__input" aria-label="Home care tips heading" maxlength="120" placeholder="Caring for {pet}’s teeth at home" type="text" value=""></li><li class="report-templates__section"><div class="report-templates__section-head"><label class="report-templates__check report-templates__check--inline"><input type="checkbox" checked=""><span class="report-templates__section-name">Recheck date</span></label><span class="report-templates__section-actions"><button type="button" class="diagram-view__action report-templates__icon" aria-label="Move up" title="Move up">↑</button><button type="button" class="diagram-view__action report-templates__icon" disabled="" aria-label="Move down" title="Move down">↓</button></span></div><input class="patient-form__input" aria-label="Recheck date heading" maxlength="120" placeholder="Recommended recheck" type="text" value=""></li></ol><button type="button" class="diagram-view__action">+ Add a custom text section</button></section><section class="ai-settings-section"><h3 class="ai-settings-subhead">Home care tips</h3><p class="patient-form__hint">Using the standard tips:</p><ul class="report-templates__default-tips"><li>Daily tooth brushing with a pet-safe toothpaste is the single most effective thing you can do.</li><li>Dental diets, chews, and water additives with the VOHC seal help between brushings.</li><li>Watch for bad breath, drooling, dropping food, or pawing at the mouth — call us if you notice any.</li></ul><button type="button" class="diagram-view__action">Customize these tips</button><span class="patient-form__hint">Each chart can still edit its own tips in the Owner Report section.</span></section><section class="ai-settings-section"><h3 class="ai-settings-subhead">Closing and footer</h3><label class="patient-form__label">Closing note<textarea class="patient-form__input report-templates__textarea" rows="2" placeholder="e.g. Thank you for trusting us with {pet}'s care!"></textarea></label><label class="patient-form__label">Footer<input class="patient-form__input" maxlength="200" placeholder="e.g. (555) 010-0100 · www.example-vet.com · Open Mon–Sat" type="text" value=""><span class="patient-form__hint">Printed in small type at the bottom of every page.</span></label></section></fieldset></div></div><footer class="ai-settings-footer report-templates__footer"><button type="button" class="diagram-view__action" aria-label="Preview with sample visit"><span class="report-templates__long">Preview with sample visit</span><span class="report-templates__short">Preview</span></button><span class="ai-settings-spacer"></span><button type="button" class="diagram-view__action report-templates__cancel">Cancel</button><button type="button" class="entry-grid__button entry-grid__button--topbar" disabled="">Save templates</button></footer></div></div></div>"`;

exports[`settings dialogs on the website render as before > Owner report templates (read-only) 1`] = `"<div><div class="ai-settings-overlay" role="dialog" aria-modal="true" aria-labelledby="report-templates-title"><div class="ai-settings-modal report-templates" tabindex="-1"><header class="ai-settings-header"><h2 id="report-templates-title">Owner report templates</h2><button type="button" class="pdf-preview-close" aria-label="Close">×</button></header><div class="report-templates__body"><nav class="report-templates__list" aria-label="Templates"><ul><li><button type="button" class="report-templates__item report-templates__item--on" aria-current="true"><span class="report-templates__item-name">Standard</span><span class="report-templates__item-meta"><span class="report-templates__badge">Default</span></span></button></li></ul></nav><div class="report-templates__editor"><p class="login-notice" role="status">Only practice owners can edit. You can look through the templates and preview them.</p><fieldset class="report-templates__fieldset" disabled=""><section class="ai-settings-section"><h3 class="ai-settings-subhead">Basics</h3><div class="report-templates__row"><label class="patient-form__label">Template name<input class="patient-form__input" maxlength="80" type="text" value="Standard"></label><label class="patient-form__label">Report title<input class="patient-form__input" maxlength="80" placeholder="No title" type="text" value="Dental Visit Report"></label></div><div class="report-templates__row"><label class="patient-form__label">Report language<select class="patient-form__input"><option value="en">English</option><option value="es">Español (Spanish)</option><option value="fr">Français (French)</option><option value="de">Deutsch (German)</option><option value="it">Italiano (Italian)</option><option value="pt">Português (Portuguese)</option></select></label><label class="patient-form__label">Dates<select class="patient-form__input"><option value="iso">As charted (2026-07-19)</option><option value="long">Written out, in the report language</option></select></label></div><p class="patient-form__hint">The language applies to everything the report writes for you — headings, findings, tooth names and default text. Text your team types prints as written.</p><label class="report-templates__check"><input type="checkbox" checked=""><span>Show tooth numbers <span class="patient-form__hint">— “Upper right canine tooth (104)” instead of “Upper right canine tooth”</span></span></label><label class="report-templates__check"><input type="checkbox" checked=""><span>Show grades and measurements <span class="patient-form__hint">— “tartar buildup (grade 2)” instead of “tartar buildup”</span></span></label></section><section class="ai-settings-section"><h3 class="ai-settings-subhead">Opening summary</h3><div class="report-templates__chips" role="group" aria-label="Insert a placeholder"><button type="button" class="report-templates__chip" title="Insert pet name">{pet}</button><button type="button" class="report-templates__chip" title="Insert owner name">{owner}</button><button type="button" class="report-templates__chip" title="Insert cat, dog…">{species}</button><button type="button" class="report-templates__chip" title="Insert visit date">{date}</button><button type="button" class="report-templates__chip" title="Insert practice name">{practice}</button><button type="button" class="report-templates__chip" title="Insert doctor">{doctor}</button></div><p class="patient-form__hint">Click a placeholder to insert it into the field you’re editing (any text field below). Capitalize it — {Pet} — to capitalize the value.</p><textarea class="patient-form__input report-templates__textarea" rows="4" aria-label="Opening summary template" placeholder="{pet} had a professional dental assessment and cleaning under anesthesia. This report explains what we found in everyday language — the full clinical chart with measurements is on file and available any time."></textarea><span class="patient-form__hint">Leave empty to use the standard opening shown in grey.</span></section><section class="ai-settings-section"><h3 class="ai-settings-subhead">Sections</h3><p class="patient-form__hint">Turn sections on or off, rename their headings, and set the print order. Sections with nothing to say for a visit (no extractions, no photos…) are skipped automatically.</p><ol class="report-templates__sections"><li class="report-templates__section"><div class="report-templates__section-head"><label class="report-templates__check report-templates__check--inline"><input type="checkbox" checked=""><span class="report-templates__section-name">Teeth removed</span></label><span class="report-templates__section-actions"><button type="button" class="diagram-view__action report-templates__icon" disabled="" aria-label="Move up" title="Move up">↑</button><button type="button" class="diagram-view__action report-templates__icon" aria-label="Move down" title="Move down">↓</button></span></div><input class="patient-form__input" aria-label="Teeth removed heading" maxlength="120" placeholder="Teeth removed during this visit" type="text" value=""></li><li class="report-templates__section"><div class="report-templates__section-head"><label class="report-templates__check report-templates__check--inline"><input type="checkbox" checked=""><span class="report-templates__section-name">Mouth diagram</span></label><span class="report-templates__section-actions"><button type="button" class="diagram-view__action report-templates__icon" aria-label="Move up" title="Move up">↑</button><button type="button" class="diagram-view__action report-templates__icon" aria-label="Move down" title="Move down">↓</button></span></div><input class="patient-form__input" aria-label="Mouth diagram heading" maxlength="120" placeholder="{Pet}’s mouth" type="text" value=""></li><li class="report-templates__section"><div class="report-templates__section-head"><label class="report-templates__check report-templates__check--inline"><input type="checkbox" checked=""><span class="report-templates__section-name">What we found</span></label><span class="report-templates__section-actions"><button type="button" class="diagram-view__action report-templates__icon" aria-label="Move up" title="Move up">↑</button><button type="button" class="diagram-view__action report-templates__icon" aria-label="Move down" title="Move down">↓</button></span></div><input class="patient-form__input" aria-label="What we found heading" maxlength="120" placeholder="What we found" type="text" value=""></li><li class="report-templates__section"><div class="report-templates__section-head"><label class="report-templates__check report-templates__check--inline"><input type="checkbox" checked=""><span class="report-templates__section-name">Already missing</span></label><span class="report-templates__section-actions"><button type="button" class="diagram-view__action report-templates__icon" aria-label="Move up" title="Move up">↑</button><button type="button" class="diagram-view__action report-templates__icon" aria-label="Move down" title="Move down">↓</button></span></div><input class="patient-form__input" aria-label="Already missing heading" maxlength="120" placeholder="Already missing before this visit" type="text" value=""></li><li class="report-templates__section"><div class="report-templates__section-head"><label class="report-templates__check report-templates__check--inline"><input type="checkbox" checked=""><span class="report-templates__section-name">Other exam notes</span></label><span class="report-templates__section-actions"><button type="button" class="diagram-view__action report-templates__icon" aria-label="Move up" title="Move up">↑</button><button type="button" class="diagram-view__action report-templates__icon" aria-label="Move down" title="Move down">↓</button></span></div><input class="patient-form__input" aria-label="Other exam notes heading" maxlength="120" placeholder="Other exam notes" type="text" value=""></li><li class="report-templates__section"><div class="report-templates__section-head"><label class="report-templates__check report-templates__check--inline"><input type="checkbox" checked=""><span class="report-templates__section-name">Before &amp; after photos</span></label><span class="report-templates__section-actions"><button type="button" class="diagram-view__action report-templates__icon" aria-label="Move up" title="Move up">↑</button><button type="button" class="diagram-view__action report-templates__icon" aria-label="Move down" title="Move down">↓</button></span></div><input class="patient-form__input" aria-label="Before &amp; after photos heading" maxlength="120" placeholder="Before &amp; after" type="text" value=""></li><li class="report-templates__section"><div class="report-templates__section-head"><label class="report-templates__check report-templates__check--inline"><input type="checkbox" checked=""><span class="report-templates__section-name">Note from the team</span></label><span class="report-templates__section-actions"><button type="button" class="diagram-view__action report-templates__icon" aria-label="Move up" title="Move up">↑</button><button type="button" class="diagram-view__action report-templates__icon" aria-label="Move down" title="Move down">↓</button></span></div><input class="patient-form__input" aria-label="Note from the team heading" maxlength="120" placeholder="A note from your veterinary team" type="text" value=""></li><li class="report-templates__section"><div class="report-templates__section-head"><label class="report-templates__check report-templates__check--inline"><input type="checkbox" checked=""><span class="report-templates__section-name">Home care tips</span></label><span class="report-templates__section-actions"><button type="button" class="diagram-view__action report-templates__icon" aria-label="Move up" title="Move up">↑</button><button type="button" class="diagram-view__action report-templates__icon" aria-label="Move down" title="Move down">↓</button></span></div><input class="patient-form__input" aria-label="Home care tips heading" maxlength="120" placeholder="Caring for {pet}’s teeth at home" type="text" value=""></li><li class="report-templates__section"><div class="report-templates__section-head"><label class="report-templates__check report-templates__check--inline"><input type="checkbox" checked=""><span class="report-templates__section-name">Recheck date</span></label><span class="report-templates__section-actions"><button type="button" class="diagram-view__action report-templates__icon" aria-label="Move up" title="Move up">↑</button><button type="button" class="diagram-view__action report-templates__icon" disabled="" aria-label="Move down" title="Move down">↓</button></span></div><input class="patient-form__input" aria-label="Recheck date heading" maxlength="120" placeholder="Recommended recheck" type="text" value=""></li></ol><button type="button" class="diagram-view__action">+ Add a custom text section</button></section><section class="ai-settings-section"><h3 class="ai-settings-subhead">Home care tips</h3><p class="patient-form__hint">Using the standard tips:</p><ul class="report-templates__default-tips"><li>Daily tooth brushing with a pet-safe toothpaste is the single most effective thing you can do.</li><li>Dental diets, chews, and water additives with the VOHC seal help between brushings.</li><li>Watch for bad breath, drooling, dropping food, or pawing at the mouth — call us if you notice any.</li></ul><button type="button" class="diagram-view__action">Customize these tips</button><span class="patient-form__hint">Each chart can still edit its own tips in the Owner Report section.</span></section><section class="ai-settings-section"><h3 class="ai-settings-subhead">Closing and footer</h3><label class="patient-form__label">Closing note<textarea class="patient-form__input report-templates__textarea" rows="2" placeholder="e.g. Thank you for trusting us with {pet}'s care!"></textarea></label><label class="patient-form__label">Footer<input class="patient-form__input" maxlength="200" placeholder="e.g. (555) 010-0100 · www.example-vet.com · Open Mon–Sat" type="text" value=""><span class="patient-form__hint">Printed in small type at the bottom of every page.</span></label></section></fieldset></div></div><footer class="ai-settings-footer report-templates__footer"><button type="button" class="diagram-view__action" aria-label="Preview with sample visit"><span class="report-templates__long">Preview with sample visit</span><span class="report-templates__short">Preview</span></button><span class="ai-settings-spacer"></span><button type="button" class="entry-grid__button entry-grid__button--topbar">Close</button></footer></div></div></div>"`;

exports[`settings dialogs on the website render as before > Practice settings 1`] = `"<div><div class="ai-settings-overlay" role="dialog" aria-modal="true" aria-labelledby="practice-settings-title"><div class="ai-settings-modal" tabindex="-1"><header class="ai-settings-header"><h2 id="practice-settings-title">Practice settings</h2><button type="button" class="pdf-preview-close" aria-label="Close">×</button></header><div class="ai-settings-body"><form class="ai-settings-section"><h3 class="ai-settings-subhead">Profile</h3><label class="patient-form__label">Practice name<input class="patient-form__input" placeholder="Shown in the app and on every chart" type="text" value="SoCal Vet"></label></form><section class="ai-settings-section"><span class="patient-form__label">Practice logo</span><div class="practice-logo-row"><span class="practice-logo-empty">No logo uploaded — charts use the template's built-in mark.</span><button type="button" class="diagram-view__action">Upload logo</button></div><input accept="image/png,image/jpeg,image/webp" style="display: none;" aria-label="Choose a logo image" type="file"></section><section class="ai-settings-section"><h3 class="ai-settings-subhead">Team</h3><p class="ai-settings-blurb">Colleagues you add share this practice’s charts, templates, and images.</p><ul class="team__members"><li class="team__member"><span class="team__member-id"><strong>me@vet.com (you)</strong><span class="team__member-name">Dr Me</span></span><span class="team__member-role">Primary owner</span></li><li class="team__member"><span class="team__member-id"><strong>joined@vet.com</strong></span><span class="team__member-role">Member</span><span class="team__member-actions"><button type="button" class="diagram-view__action">Make owner</button><button type="button" class="diagram-view__action">Transfer ownership</button><button type="button" class="diagram-view__action diagram-view__action--danger">Remove</button></span></li><li class="team__member"><span class="team__member-id"><strong>pending@vet.com</strong></span><span class="team__badge team__badge--pending">Pending invite</span><span class="team__member-role">Member</span><span class="team__member-actions"><button type="button" class="diagram-view__action">Resend invite</button><button type="button" class="diagram-view__action diagram-view__action--danger">Remove</button></span></li></ul><form class="practice-team__add" novalidate=""><input class="patient-form__input" placeholder="Colleague's email" aria-label="Colleague's email" autocomplete="off" type="email" value=""><button type="submit" class="diagram-view__action" disabled="">Add</button></form><p class="patient-form__hint">No account yet? We'll email them an invite to set a password and join.</p></section><section class="ai-settings-section"><h3 class="ai-settings-subhead">Language for pet owners</h3><p class="ai-settings-blurb">The language used for text families receive, such as owner report defaults. Typed text is never translated.</p><select class="patient-form__input" aria-label="Language for pet owners"><option value="en">English</option><option value="es">Español (Spanish)</option><option value="fr">Français (French)</option><option value="de">Deutsch (German)</option><option value="it">Italiano (Italian)</option><option value="pt">Português (Portuguese)</option></select></section><section class="ai-settings-section"><h3 class="ai-settings-subhead">Owner report</h3><p class="ai-settings-blurb">The report families take home after a dental visit — sections, headings, wording, language, and the practice-wide default layout.</p><button type="button" class="diagram-view__action">Customize owner report</button></section><section class="ai-settings-section"><h3 class="ai-settings-subhead">Billing</h3><p class="practice-logo-empty">Loading billing…</p></section><section class="ai-settings-section"><h3 class="ai-settings-subhead">Delete practice</h3><p class="patient-form__hint">Permanently deletes the practice and every chart shared with it, including your team’s, and cancels any subscription. Team members keep their accounts and private charts.</p><div class="practice-logo-actions"><button type="button" class="diagram-view__action diagram-view__action--danger">Delete practice…</button></div></section></div><footer class="ai-settings-footer"><button type="button" class="entry-grid__button entry-grid__button--topbar">Done</button></footer></div></div></div>"`;

exports[`settings dialogs on the website render as before > Recheck reminders 1`] = `"<div><div class="ai-settings-overlay" role="dialog" aria-modal="true" aria-label="Recheck reminders"><div class="ai-settings-modal" tabindex="-1"><header class="ai-settings-header"><h2>Recheck reminders</h2><button type="button" class="pdf-preview-close" aria-label="Close">×</button></header><div class="ai-settings-body"><section class="ai-settings-section"><p class="ai-settings-blurb">Email the pet owner when a recheck is due. Placeholders: <code>{{patient}}</code> <code>{{owner}}</code> <code>{{practice}}</code> <code>{{recheck_date}}</code>. Send a reminder for one patient from <strong>My charts</strong>.</p><label class="patient-form__label" style="flex-direction: row; align-items: center; gap: 0.5rem;"><input type="checkbox">Automatically email owners</label><label class="patient-form__label" style="margin-top: 0.6rem;">Send<select class="patient-form__input"><option value="0">On the recheck date</option><option value="3">3 days before</option><option value="7">1 week before</option><option value="14">2 weeks before</option><option value="30">1 month before</option></select></label><label class="patient-form__label" style="margin-top: 0.6rem;">Subject<input class="patient-form__input" value="Recheck for {{patient}}"></label><label class="patient-form__label" style="margin-top: 0.6rem;">Message<textarea class="patient-form__textarea reminder__body">Hello {{owner}}</textarea></label></section></div><footer class="ai-settings-footer"><button type="button" class="entry-grid__button entry-grid__button--topbar">Done</button></footer></div></div></div>"`;

exports[`settings dialogs on the website render as before > Report templates 1`] = `"<div><div class="ai-settings-overlay" role="dialog" aria-modal="true" aria-label="Report templates"><div class="ai-settings-modal"><header class="ai-settings-header"><h2>Report templates</h2><button type="button" class="pdf-preview-close" aria-label="Close">×</button></header><div class="ai-settings-body"><section class="ai-settings-section"><div class="report-templates__list-head"><span class="patient-form__label">Saved templates</span><button type="button" class="diagram-view__action">New template</button></div><ul class="report-templates__list"><li><button type="button" class="report-templates__item">Dental</button></li></ul></section><section class="ai-settings-section"><label class="patient-form__label">Template name<input class="patient-form__input" placeholder="e.g. Routine cleaning (feline)" type="text" value=""></label><label class="patient-form__label" style="margin-top: 0.75rem;">Report text<textarea class="patient-form__textarea report-templates__body" placeholder="The report text inserted into Treatment &amp; Surgery Report…">Draft</textarea></label></section></div><footer class="ai-settings-footer"><button type="button" class="diagram-view__action">Close</button><button type="button" class="entry-grid__button entry-grid__button--topbar">Save template</button></footer></div></div></div>"`;

exports[`settings dialogs on the website render as before > Send feedback 1`] = `"<div></div><div class="ai-settings-overlay feedback-overlay" role="dialog" aria-modal="true" aria-label="Send feedback"><form class="ai-settings-modal feedback-modal" tabindex="-1"><header class="ai-settings-header"><h2>Send feedback</h2><button type="button" class="pdf-preview-close" aria-label="Close">×</button></header><div class="ai-settings-body"><div class="feedback-modal__kinds" role="radiogroup" aria-label="Type of feedback"><button type="button" role="radio" aria-checked="true" class="feedback-modal__kind feedback-modal__kind--on">Something’s wrong</button><button type="button" role="radio" aria-checked="false" class="feedback-modal__kind">Idea</button><button type="button" role="radio" aria-checked="false" class="feedback-modal__kind">Other</button></div><label class="patient-form__label">What happened?<textarea class="patient-form__input feedback-modal__message" rows="6" maxlength="5000" placeholder="What you did, what you expected, what happened instead…"></textarea></label><label class="feedback-modal__attach"><input type="checkbox" checked="">Include my dictation transcript</label><p class="feedback-modal__note">Goes straight to the ToothOps developer, who’ll reply to your email.</p></div><footer class="ai-settings-footer"><button type="button" class="diagram-view__action">Cancel</button><button type="submit" class="entry-grid__button entry-grid__button--topbar" disabled="">Send</button></footer></form></div>"`;

exports[`settings dialogs on the website render as before > What’s new 1`] = `"<div></div><div class="ai-settings-overlay" role="dialog" aria-modal="true" aria-labelledby="whats-new-title"><div class="ai-settings-modal whats-new" tabindex="-1"><header class="ai-settings-header"><h2 id="whats-new-title">What’s new in ToothOps</h2><button type="button" class="pdf-preview-close" aria-label="Close">×</button></header><div class="ai-settings-body whats-new__body"><p class="whats-new__intro">A big round of updates, most of them straight from your feedback — thank you!</p><section class="whats-new__group"><h3 class="ai-settings-subhead">Dictation</h3><ul class="whats-new__list"><li><strong>Dictate from any page.</strong> The button is now 🎤 Dictate. Talk through your findings from wherever you are — each one lands in the right place.</li><li><strong>More accurate, with a final check.</strong> It catches findings split across pauses and your corrections. When you tap Stop it re-reads the whole recording and lists anything it wasn’t sure about under Needs review.</li><li><strong>Better on phones.</strong> Dictation opens full screen and keeps your screen awake while you talk.</li><li><strong>Understands more.</strong> “GE 3” for enlargement, pocket depths per root, the caudal maxillary block and radiographic findings.</li></ul></section><section class="whats-new__group"><h3 class="ai-settings-subhead">Charting</h3><ul class="whats-new__list"><li><strong>Pocket depth per root.</strong> Charting → Customize → One per root. Multi-rooted teeth get a labelled box per root (M / D, or MB / MP / D).</li><li><strong>Set several teeth at once.</strong> Click tooth numbers in the grid (Shift-click for a range), then set one score on all of them.</li><li><strong>Make it yours.</strong> Every page has a Customize button: hide columns, choose what shows beside the teeth, what the Space key does, and more. Settings follow your account to every device.</li></ul></section><section class="whats-new__group"><h3 class="ai-settings-subhead">Records</h3><ul class="whats-new__list"><li><strong>Radiographic findings.</strong> A dedicated box on the Images page. It prints on the PDF above the treatment report.</li><li><strong>Anesthesia.</strong> Caudal maxillary block added. Hide the blocks you don’t use, and save your usual anesthetic for one-tap entry.</li><li><strong>Skip the recheck field.</strong> Don’t use recheck reminders? Patient → Customize → Hide the Recheck due field.</li></ul></section><section class="whats-new__group"><h3 class="ai-settings-subhead">Owner report</h3><ul class="whats-new__list"><li><strong>✨ Write with AI.</strong> Drafts the opening summary and home care advice from the chart, using only what you charted. You review before printing.</li><li><strong>Customize the report.</strong> Change its layout, wording and language right from the Owner Report page.</li></ul></section><section class="whats-new__group"><h3 class="ai-settings-subhead">Everyday</h3><ul class="whats-new__list"><li><strong>Starts where you left off.</strong> Opening ToothOps fresh shows My charts — unless today’s visit is still open — and today’s visit opens ready to edit.</li><li><strong>Send feedback in two taps.</strong> Settings → Send feedback, or Feedback in the dictation panel (it can attach your transcript). It comes straight to us.</li></ul></section></div><footer class="ai-settings-footer"><button type="button" class="entry-grid__button entry-grid__button--topbar">Got it</button></footer></div></div>"`;
