# react-scripts 5 (CRA, unmaintained) peer-depends on typescript ^3||^4
# and React-18-era packages; this project is on typescript 5.9 + React 19,
# which work fine but make older npm's strict peer resolution refuse to
# install (Vercel's npm hard-fails on ERESOLVE where npm 11+ is lenient).
legacy-peer-deps=true
