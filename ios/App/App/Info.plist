	<string>Attach photos and radiographs to a patient's chart.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Dictate findings into the chart.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Unlock ToothOps to protect patient records.</string>
